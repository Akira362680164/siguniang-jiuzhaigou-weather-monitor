{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "module",
    "status",
    "generated_at",
    "data_date",
    "source",
    "years",
    "window_days_each_side",
    "query_windows",
    "target_groups",
    "requests"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "module": {"const": "historical_comparison"},
    "status": {"enum": ["OK", "PARTIAL", "FAILED"]},
    "generated_at": {"type": "string"},
    "data_date": {"type": "string", "format": "date"},
    "source": {"type": "string"},
    "years": {"type": "array", "minItems": 3, "items": {"type": "integer"}},
    "window_days_each_side": {"type": "integer", "minimum": 0},
    "query_windows": {"type": "object"},
    "target_groups": {"type": "object"},
    "requests": {"type": "object"},
    "failures": {"type": "object"}
  },
  "additionalProperties": true
}
